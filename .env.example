# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID пользователей через запятую (узнать у @userinfobot)
ALLOWED_USERS=id1,id2,id3

# ── База данных ────────────────────────────────────────────
DB_PATH=portfolio.db

# ── Mini App (Telegram WebApp) ─────────────────────────────
# Адрес, на котором слушает HTTP-сервер
WEBAPP_ADDR=:8080

# Публичный HTTPS URL, по которому Telegram открывает Mini App.
# Должен быть HTTPS с валидным сертификатом!
# Например: https://yourdomain.com  или  https://crypto-bot.example.com
# Если пусто — Mini App кнопка не устанавливается, только бот работает.
WEBAPP_URL=

# ── Примечания ─────────────────────────────────────────────
# /news, /unlock-tokens, /market, /recommend — бесплатно, без ключей
# /bybit — каждый пользователь вводит свои ключи через бот или Mini App
