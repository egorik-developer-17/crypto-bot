# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID пользователей через запятую (узнать у @userinfobot)
ALLOWED_USERS=id1,id2,id3

# ── База данных ────────────────────────────────────────────
DB_PATH=portfolio.db

# ── Примечания ─────────────────────────────────────────────
