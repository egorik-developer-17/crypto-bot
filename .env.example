# Токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Строка подключения к PostgreSQL (если используется)
DATABASE_URL=postgres://user:password@localhost:5432/cryptobot?sslmode=disable

# Ваш Telegram ID (получить можно у @userinfobot)
OWNER_ID=your_telegram_id_here

# Путь к файлу SQLite базы данных
DB_PATH=portfolio.db
