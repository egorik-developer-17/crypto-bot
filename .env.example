# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# Telegram ID пользователей через запятую (узнать у @userinfobot)
ALLOWED_USERS=id1,id2,id3

# ── База данных ────────────────────────────────────────────
DB_PATH=portfolio.db

# ── Разлоки токенов (опционально) ─────────────────────────
# Бесплатный ключ: https://coinmarketcal.com → Register → API
# Без ключа команда /unlock-tokens недоступна
COINMARKETCAL_KEY=your_coinmarketcal_key_here

# ── Примечания ─────────────────────────────────────────────
# /news работает БЕЗ ключей (CryptoCompare бесплатно)
# /bybit — ключи каждый пользователь вводит через /bybit connect
